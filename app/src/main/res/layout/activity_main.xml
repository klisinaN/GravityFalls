<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1B261D"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <Button
            android:id="@+id/btnMorning"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#F39C12"
            android:onClick="btnMorningClick"
            android:text="@string/button_morning"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#27AE60"
            android:onClick="btnDayClick"
            android:text="@string/button_day"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnEvening"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#D35400"
            android:onClick="btnEveningClick"
            android:text="@string/button_evening"
            android:textColor="@android:color/white" />

        <Button
            android:id="@+id/btnNight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#2C3E50"
            android:onClick="btnNightClick"
            android:text="@string/button_night"
            android:textColor="@android:color/white" />
    </LinearLayout>
    <FrameLayout
        android:id="@+id/frameLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/linearLayout"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <ImageView
            android:id="@+id/imageNight"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:srcCompat="@drawable/hight" />
        <ImageView
            android:id="@+id/imageEvening"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:srcCompat="@drawable/evening" />
        <ImageView
            android:id="@+id/imageDay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="invisible"
            app:srcCompat="@drawable/day" />
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutMorning"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">
            <ImageView
                android:id="@+id/imageMorning"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:srcCompat="@drawable/morning" />
            <Button
                android:id="@+id/btnDipper"
                android:layout_width="110dp"
                android:layout_height="180dp"
                android:layout_marginStart="40dp"
                android:layout_marginBottom="60dp"
                android:background="@android:color/transparent"
                android:onClick="onDipperClick"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />
            <Button
                android:id="@+id/btnMabel"
                android:layout_width="110dp"
                android:layout_height="180dp"
                android:layout_marginEnd="50dp"
                android:layout_marginBottom="60dp"
                android:background="@android:color/transparent"
                android:onClick="onMabelClick"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />
            <Button
                android:id="@+id/btnShack"
                android:layout_width="220dp"
                android:layout_height="150dp"
                android:layout_marginTop="80dp"
                android:background="@android:color/transparent"
                android:onClick="onShackClick"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintRight_toRightOf="parent" />
            <Button
                android:id="@+id/btnJournal"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:layout_marginBottom="120dp"
                android:background="@android:color/transparent"
                android:onClick="onJournalClick"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnDipper" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>